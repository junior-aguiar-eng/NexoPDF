# Preserve document and asset bytes; Unix scripts explicitly use LF.
# Windows checkouts default to core.autocrlf=true, which rewrote signed PDFs (breaking their
# signatures) and assets whose SHA-256 ATTRIBUTION.toml records (cargo xtask assets).
* -text

# Not text at all: no textual diffs or merges either.
*.pdf binary
*.p12 binary
*.pfb binary
*.ttf binary
*.icc binary
*.icns binary
*.ico binary
*.png binary
*.brotli binary

# Shell scripts must remain executable on Unix and pass ShellCheck.
*.sh text eol=lf
*.desktop text eol=lf
.github/workflows/*.yml text eol=lf
